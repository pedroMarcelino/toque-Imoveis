# conexão MongoDB (URI completa com usuário e senha, ex:
# mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?appName=<app>)
MONGO_URI=

# port backend develop
PORT=3000

# cloudinary APIS
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# segredo do JWT (gere um valor forte, ex: openssl rand -base64 32)
JWT_SECRET=

# limite de fotos por upload e por imóvel (default: 10 cada)
MAX_IMAGES_PER_UPLOAD=
MAX_TOTAL_IMAGES=